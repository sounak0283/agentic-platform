# Copy this file to .env and fill in real values. .env is gitignored.

# Primary provider used for MVP smoke tests.
MOONSHOT_API_KEY=
# Wired but not required until you use these providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Tool keys (opt-in, side-effecting tools only). Not required unless a project
# explicitly enables the matching tool in its available_tools.
TAVILY_API_KEY=            # required by the "web_search" tool
WOLFRAM_ALPHA_APPID=       # required by the "wolfram_alpha" tool
PUBMED_API_KEY=            # optional; raises NCBI's rate limit for the "pubmed" tool
