# Copy this file to .env and fill in real values. .env is gitignored.

# Primary provider used for MVP smoke tests.
MOONSHOT_API_KEY=
# Wired but not required until you use these providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Tool keys (opt-in, side-effecting tools only). Not required unless a project
# explicitly enables "web_search" in its available_tools.
TAVILY_API_KEY=
